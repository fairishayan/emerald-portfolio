generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Submission {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  type      String   @default("GENERAL") // "FEEDBACK" | "QUERY" | "COLLABORATION" | "GENERAL"
  createdAt DateTime @default(now()) @map("created_at")
  isRead    Boolean  @default(false) @map("is_read")

  @@map("submissions")
}

